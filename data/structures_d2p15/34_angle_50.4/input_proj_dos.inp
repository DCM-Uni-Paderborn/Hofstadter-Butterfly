&GLOBAL
  RUN_TYPE  ENERGY
  PROJECT_NAME graphene_pdos
  PRINT_LEVEL  MEDIUM
  EXTENDED_FFT_LENGTHS
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    SPIN_POLARIZED  TRUE
    !MULTIPLICITY   1  
    CHARGE         0

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    !&POISSON
    !  POISSON_SOLVER WAVELET
    !  PERIODIC NONE
    !&END POISSON

    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10 # overall accuracy of the calculations
    &END QS

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &vdW_POTENTIAL
         DISPERSION_FUNCTIONAL PAIR_POTENTIAL
         &PAIR_POTENTIAL
            TYPE DFTD3
            CALCULATE_C9_TERM .TRUE.
            REFERENCE_C9_TERM .TRUE.
            LONG_RANGE_CORRECTION .FALSE.
            PARAMETER_FILE_NAME dftd3.dat
            VERBOSE_OUTPUT .FALSE.
            REFERENCE_FUNCTIONAL PBE
            #R_CUTOFF [angstrom] 10.0
            #EPS_CN 1.0E-6
         &END PAIR_POTENTIAL
      &END vdW_POTENTIAL
    &END XC

    &MGRID
      CUTOFF 300
      NGRIDS 5
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-5
      MAX_SCF 6000
      ADDED_MOS 300
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K]  300
      &END SMEAR
      &DIAGONALIZATION
        ALGORITHM STANDARD
        EPS_ADAPT 0.01
      &END DIAGONALIZATION
      &MIXING
        !NMIXING  6
        METHOD   BROYDEN_MIXING
        ALPHA    0.2
        NBUFFER  10
      &END MIXING
    &END SCF
    &PRINT
       &DOS
	DELTA_E 0.0001
       &END DOS
!    &END PRINT
!    &PRINT
       &PDOS
          &LDOS
	    COMPONENTS
	    LIST 1..1250
	  &END LDOS
       &END PDOS
    &END PRINT
  &END DFT
  &SUBSYS
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 1 1 1
      CONNECTIVITY OFF
      COORD_FILE_NAME atoms.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &CELL
      @INCLUDE 'cell.dat'
      MULTIPLE_UNIT_CELL 1 1 1
      PERIODIC XYZ
    &END CELL

    &KIND C
      BASIS_SET SZV-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND H
      BASIS_SET SZV-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
